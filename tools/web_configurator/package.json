{
  "name": "web_configurator",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:network": "vite --host --port 5174",
    "watch:display-sim": "node --experimental-strip-types wasm-display-sim/watch.ts",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "node --test --experimental-strip-types src/__tests__/*.test.ts",
    "test:e2e": "node --experimental-strip-types e2e/run.ts",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.ts\" \"e2e/**/*.ts\" \"wasm-display-sim/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"e2e/**/*.ts\" \"wasm-display-sim/*.ts\"",
    "lint": "eslint \"src/**/*.ts\" \"e2e/**/*.ts\" \"wasm-display-sim/*.ts\"",
    "lint:fix": "eslint --fix \"src/**/*.ts\" \"e2e/**/*.ts\" \"wasm-display-sim/*.ts\"",
    "check": "npm run typecheck && npm run lint && npm run format:check",
    "preflight": "npm run check && npm test && npm run test:e2e"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@typescript-eslint/eslint-plugin": "8.67.0",
    "@typescript-eslint/parser": "8.67.0",
    "eslint": "10.8.1",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-unused-imports": "4.4.1",
    "playwright": "^1.62.1",
    "prettier": "3.9.6",
    "typescript": "~6.0.2",
    "vite": "^8.2.0"
  }
}
